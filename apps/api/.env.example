# Lokale Entwicklung. Auf dem VPS kommen die Werte aus /etc/subwarfare/api.env.
PORT=8090
HOST=0.0.0.0

# MUSS identisch zum Spielserver sein — damit werden die Join-Tickets signiert.
# Produktiv erzeugen mit: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me
INTERNAL_KEY=dev-internal-key

# Anmeldung ohne externe Anbieter. Produktiv auf 0 setzen bzw. weglassen.
AUTH_DEV=1
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com

# Discord-Login (funktioniert auch ohne Domain, mit nackter IP):
# Anwendung unter https://discord.com/developers/applications anlegen,
# OAuth2 → Redirect exakt wie DISCORD_REDIRECT_URI eintragen.
# DISCORD_CLIENT_ID=...
# DISCORD_CLIENT_SECRET=...
# DISCORD_REDIRECT_URI=http://localhost:8090/api/auth/discord/callback
# Wohin der Browser nach dem Login zurückkehrt (Client-App).
# CLIENT_URL=http://localhost:5173

# Ohne diese Zeile liegen Konten nur im Arbeitsspeicher.
# DATABASE_URL=mysql://subwarfare:passwort@127.0.0.1:3306/subwarfare

GAME_INTERNAL_URL=http://127.0.0.1:8080
GAME_PUBLIC_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:5173
