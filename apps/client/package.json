{
  "name": "@subwarfare/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-Client (Vue 3 + Vite + PixiJS/WebGL)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@subwarfare/shared": "workspace:*",
    "pixi.js": "^8.19.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.9"
  }
}
