# Lokale Entwicklung: Backend auf eigenem Port. Auf dem VPS bleibt die
# Variable UNGESETZT — dann gilt die gleiche Herkunft wie der Client selbst.
VITE_API_URL=http://localhost:8090

# Google-Anmeldung. Ohne Wert erscheint der Knopf nicht (Dev-Login reicht).
# VITE_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
